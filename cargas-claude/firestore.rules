rules_version = '2';
// Reglas de Firestore del CRM FG con el usuario exclusivo de Claude.
// Se pegan en Firebase › Firestore Database › Reglas › Publicar.
// Todos los usuarios del CRM siguen igual que antes (cualquier usuario con sesión iniciada lee y escribe).
// El usuario de Claude solo puede CREAR cargas pendientes en crm_cargas_claude: no puede leer ni cambiar nada más.
service cloud.firestore {
  match /databases/{database}/documents {
    function esClaude() {
      return request.auth != null && request.auth.token.email == 'claude-bot@altacorredores.com';
    }
    function usuarioCRM() {
      return request.auth != null && !esClaude();
    }

    match /{document=**} {
      allow read, write: if usuarioCRM();
    }

    match /crm_cargas_claude/{id} {
      allow create: if esClaude()
        && request.resource.data.keys().hasOnly(['archivo', 'estado', 'creado', 'cifrado'])
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.cifrado.formato == 'fg-carga-cifrada-v1';
    }
  }
}
