rules_version = '2';
// Reglas de Storage (PDF y archivos adjuntos): el usuario de Claude no puede ver ni subir archivos.
// Se pegan en Firebase › Storage › Reglas › Publicar.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.token.email != 'claude-bot@altacorredores.com';
    }
  }
}
